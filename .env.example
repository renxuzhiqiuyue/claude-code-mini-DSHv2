# —— Planner（主智能体，必填）——
Planner_API_KEY=sk-xxxx
Planner_BASE_URL=https://api.deepseek.com
Planner_MODEL_ID=deepseek-v4-pro

# —— Solver（执行智能体）——
Solver_API_KEY=sk-xxxx
Solver_BASE_URL=https://api.deepseek.com
Solver_MODEL_ID=deepseek-v4-flash

# —— Memory（启动 Consolidation；可用 ${Solver_*} 引用 Solver）——
Memory_API_KEY=${Solver_API_KEY}
Memory_BASE_URL=${Solver_BASE_URL}
Memory_MODEL_ID=${Solver_MODEL_ID}

# —— 会话（可选；运行时会改为 session 目录名，一般无需改）——
# THREAD_ID=mini-main

# 其他参数
# DEFAULT_MAX_TOKENS=8000
# LLM_TEMPERATURE=0.3

# 重试（Recovery）
# MAX_RETRIES=3
# BASE_DELAY_MS=500

# 工具输出目录（可选，默认 .output；相对路径相对本工程根）
# OUTPUT_DIR=.output
# OUTPUT_DIR=my_runs

# 命令沙箱（bash/python）：auto | bwrap | landlock | off（默认 auto）
# auto：能用 bwrap 则把 OUTPUT_DIR 绑成 /workspace；否则用 harness/bin/landlock-run
# SANDBOX_BACKEND=auto
# SANDBOX_BACKEND=landlock
# SANDBOX_BACKEND=off

# 上下文压缩（可选，由 harness/compaction.py 读取）
# CONTEXT_CHAR_LIMIT=40000
# KEEP_RECENT_AI_MESSAGES=3
# TODO_NAG_ROUNDS=3

# 数据库（text2sql / root_cause）：本地 SQLite
# DB_SQLITE_PATH=db/data/deepReport.sqlite

# Tavily 联网搜索：当前无网络，工具每次直接返回离线提示，无需配置 KEY
# TAVILY_API_KEY=
